APP_NAME=audiax
APP_ENV=development
PORT=3000
LOG_LEVEL=debug

# Supabase -> Dashboard -> Connect.
#   Direct connection  (db.<ref>.supabase.co:5432)          resolves to IPv6 only.
#   Session pooler     (aws-<n>-<region>.pooler.supabase.com:5432)  IPv4, keeps prepared statements.
#   Transaction pooler (aws-<n>-<region>.pooler.supabase.com:6543)  IPv4, prepared statements auto-disabled by the app.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-ref.supabase.co:5432/postgres?sslmode=require
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=30m
DB_SLOW_THRESHOLD=200ms

# Upstash is TLS-only: use the rediss:// scheme, not redis://.
REDIS_URL=rediss://default:YOUR-TOKEN@your-endpoint.upstash.io:6379

# Stateless AI inference service (../audiax_model). No trailing slash.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT=120s

# Supabase Storage. The service_role key bypasses RLS -- server-side only,
# never ship it to a client. The bucket must be private: it holds workplace
# audio. No trailing slash on the URL.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
STORAGE_BUCKET=audiax-audio

SESSION_TTL=168h
BCRYPT_COST=12

SHUTDOWN_TIMEOUT=15s
CORS_ORIGINS=*
